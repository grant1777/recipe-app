[debug] [2026-08-26T18:21:51.797Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/recipe-app-f3374/rulesets {"name":"projects/recipe-app-f3374/rulesets/cc67d7d7-9479-445c-8231-fb59ab1271ac","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function householdDoc(householdId) {\n      return get(/databases/$(database)/documents/households/$(householdId));\n    }\n\n    function isHouseholdMember(householdId) {\n      return signedIn()\n        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));\n    }\n\n    match /users/{userId} {\n      allow read, create, update: if signedIn() && request.auth.uid == userId;\n    }\n\n    match /households/{householdId} {\n      allow create: if signedIn()\n        && request.resource.data.ownerUid == request.auth.uid\n        && request.resource.data.inviteToken is string;\n\n      allow read: if isHouseholdMember(householdId);\n\n      allow update: if isHouseholdMember(householdId)\n        && request.resource.data.ownerUid == resource.data.ownerUid\n        && request.resource.data.inviteToken == resource.data.inviteToken;\n\n      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;\n\n      match /members/{memberId} {\n        allow create: if signedIn()\n          && request.auth.uid == memberId\n          && request.resource.data.uid == request.auth.uid\n          && exists(/databases/$(database)/documents/households/$(householdId))\n          && (\n            householdDoc(householdId).data.ownerUid == request.auth.uid\n            || request.resource.data.inviteToken == householdDoc(householdId).data.inviteToken\n          );\n\n        allow read: if signedIn()\n          && (\n            request.auth.uid == memberId\n            || isHouseholdMember(householdId)\n          );\n\n        allow update, delete: if signedIn() && request.auth.uid == memberId;\n      }\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-26T18:21:47.842975Z","metadata":{"services":["cloud.firestore"]}}
