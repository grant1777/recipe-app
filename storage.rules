rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function approvedUser() {
      return signedIn()
        && request.auth.uid in [
          '3i7agqeptyTYIu7MVS2Vc4sLXLp2',
          '7OaNUgKTq6UVOc5pikdPiFTou0t2'
        ];
    }

    function isHouseholdMember(householdId) {
      // Cross-service lookup; the Storage service agent needs the
      // roles/firebaserules.firestoreServiceAgent IAM role.
      return approvedUser()
        && firestore.exists(/databases/(default)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function isImageUnder(limitBytes) {
      return request.resource.size < limitBytes
        && request.resource.contentType.matches('image/.*');
    }

    match /households/{householdId}/{folder}/{imageId} {
      allow read: if isHouseholdMember(householdId);
      allow create, update: if isHouseholdMember(householdId)
        && folder in ['recipes', 'ingredients']
        && isImageUnder(5 * 1024 * 1024);
      allow delete: if isHouseholdMember(householdId);
    }
  }
}
