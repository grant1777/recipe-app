rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAccessAdmin() {
      return signedIn() && request.auth.uid == '7OaNUgKTq6UVOc5pikdPiFTou0t2';
    }

    function approvedUser() {
      return signedIn()
        && (
          isAccessAdmin()
          || exists(/databases/$(database)/documents/approvedUsers/$(request.auth.uid))
        );
    }

    function householdDoc(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId));
    }

    function isHouseholdMember(householdId) {
      return approvedUser()
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    match /approvedUsers/{userId} {
      allow get: if signedIn() && (isAccessAdmin() || request.auth.uid == userId);
      allow list, create, update, delete: if isAccessAdmin();
    }

    match /accessRequests/{userId} {
      allow get: if signedIn() && (isAccessAdmin() || request.auth.uid == userId);
      allow list: if isAccessAdmin();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'requestedAt'])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.requestedAt is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.displayName.size() <= 100
        && (
          (
            'email' in request.auth.token
            && 'email_verified' in request.auth.token
            && request.auth.token.email_verified == true
            && request.resource.data.email == request.auth.token.email
          )
          || (!('email' in request.auth.token) && request.resource.data.email == '')
        );
      allow delete: if signedIn() && (isAccessAdmin() || request.auth.uid == userId);
    }

    match /users/{userId} {
      allow read, create, update: if approvedUser() && request.auth.uid == userId;
    }

    match /households/{householdId} {
      allow create: if approvedUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.inviteToken is string;

      allow read: if isHouseholdMember(householdId);

      allow update: if isHouseholdMember(householdId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.inviteToken == resource.data.inviteToken;

      allow delete: if approvedUser() && resource.data.ownerUid == request.auth.uid;

      match /members/{memberId} {
        allow create: if approvedUser()
          && request.auth.uid == memberId
          && request.resource.data.uid == request.auth.uid
          && exists(/databases/$(database)/documents/households/$(householdId))
          && (
            householdDoc(householdId).data.ownerUid == request.auth.uid
            || request.resource.data.inviteToken == householdDoc(householdId).data.inviteToken
          );

        allow read: if approvedUser()
          && (
            request.auth.uid == memberId
            || isHouseholdMember(householdId)
          );

        allow update, delete: if approvedUser() && request.auth.uid == memberId;
      }
    }
  }
}
